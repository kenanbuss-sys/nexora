{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "REDIS_URL", "INTEGRATION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@nexora/worker#test": {
      "dependsOn": ["^build", "@nexora/api#test"],
      "env": ["DATABASE_URL", "REDIS_URL", "INTEGRATION"]
    }
  }
}
