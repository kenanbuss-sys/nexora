model PurchaseOrderLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  poId        String  @map("po_id") @db.Uuid
  skuId       String  @map("sku_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 6)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  lineTotal   Decimal @map("line_total") @db.Decimal(18, 2)
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(18, 6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  po     PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([tenantId, poId])
  @@index([tenantId, skuId])
  @@map("purchase_order_line")
}

// ---------------------------------------------------------------------------
// Sprint 009 — Engineering: versioned BOMs, routings, change requests
// (ENG-001/002/003/006/007/011/013).
// ---------------------------------------------------------------------------

enum RevisionStatus {
  DRAFT
  RELEASED
  OBSOLETE
}

/// Versioned bill of materials for an output SKU (ENG-002/003). Only one
/// RELEASED version per SKU is effective at a time (ENG-006); releasing a
/// new version obsoletes the previous one.
model Bom {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  skuId         String         @map("sku_id") @db.Uuid
  version       Int            @default(1)
  status        RevisionStatus @default(DRAFT)
  effectiveFrom DateTime?      @map("effective_from")
  notes         String?
  createdBy     String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  lines  BomLine[]

  @@unique([tenantId, skuId, version])
  @@index([tenantId, skuId, status])
  @@map("bom")
}

model BomLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  bomId          String  @map("bom_id") @db.Uuid
  componentSkuId String  @map("component_sku_id") @db.Uuid
  description    String
  quantity       Decimal @db.Decimal(18, 6)
  scrapPct       Decimal @default(0) @map("scrap_pct") @db.Decimal(5, 2)
  position       Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  bom    Bom    @relation(fields: [bomId], references: [id])

  @@index([tenantId, bomId])
  @@index([tenantId, componentSkuId])
  @@map("bom_line")
}

/// Versioned routing: ordered operations with standard times (ENG-011/013).
model Routing {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  skuId     String         @map("sku_id") @db.Uuid
  version   Int            @default(1)
  status    RevisionStatus @default(DRAFT)
  createdBy String?        @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  operations RoutingOperation[]

  @@unique([tenantId, skuId, version])
  @@index([tenantId, skuId, status])
  @@map("routing")
}

model RoutingOperation {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  routingId         String  @map("routing_id") @db.Uuid
  seq               Int
  name              String
  workCenter        String  @map("work_center")
  setupMinutes      Decimal @default(0) @map("setup_minutes") @db.Decimal(10, 2)
  runMinutesPerUnit Decimal @default(0) @map("run_minutes_per_unit") @db.Decimal(10, 4)
  instructions      String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  routing Routing @relation(fields: [routingId], references: [id])

  @@unique([tenantId, routingId, seq])
  @@map("routing_operation")
}

enum EcStatus {
  OPEN
  APPROVED
  REJECTED
  IMPLEMENTED
}

/// Engineering change request (ENG-007): tracked reason for revising a
/// SKU's BOM/routing; approval is a separate permission (SoD).
model EngineeringChange {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ecNumber    String   @map("ec_number")
  targetSkuId String   @map("target_sku_id") @db.Uuid
  title       String
  status      EcStatus @default(OPEN)
  note        String?
  decidedBy   String?  @map("decided_by")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, ecNumber])
  @@index([tenantId, status])
  @@map("engineering_change")
}

// ---------------------------------------------------------------------------
// Sprint 010 — MRP & planning: policies, runs, planned-order suggestions
// (PLAN-004/005/006/007/008/009).
// ---------------------------------------------------------------------------

enum PlannedOrderType {
  PURCHASE
  PRODUCTION
}

/// Per-SKU planning policy (PLAN-004/005): safety stock and reorder
/// point feed net-requirements; lead time feeds due dates (PLAN-009).
model PlanningPolicy {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  skuId        String   @map("sku_id") @db.Uuid
  safetyStock  Decimal  @default(0) @map("safety_stock") @db.Decimal(18, 6)
  reorderPoint Decimal  @default(0) @map("reorder_point") @db.Decimal(18, 6)
  leadTimeDays Int      @default(0) @map("lead_time_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, skuId])
  @@map("planning_policy")
}

/// One MRP computation (PLAN-006/007): demand minus supply per SKU,
/// stored with its planned-order suggestions (PLAN-008). Append-only —
/// each run is a snapshot, never edited.
model MrpRun {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  runNumber       String   @map("run_number")
  demandSkus      Int      @default(0) @map("demand_skus")
  suggestionCount Int      @default(0) @map("suggestion_count")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  suggestions MrpSuggestion[]

  @@unique([tenantId, runNumber])
  @@index([tenantId, createdAt])
  @@map("mrp_run")
}

model MrpSuggestion {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  runId          String           @map("run_id") @db.Uuid
  skuId          String           @map("sku_id") @db.Uuid
  suggestionType PlannedOrderType @map("suggestion_type")
  quantity       Decimal          @db.Decimal(18, 6)
  reason         String
  dueInDays      Int              @default(0) @map("due_in_days")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  run    MrpRun @relation(fields: [runId], references: [id])

  @@index([tenantId, runId])
  @@map("mrp_suggestion")
}

// ---------------------------------------------------------------------------
// Sprint 011 — MES core: work orders, operations, WIP, material issue,
// good/scrap completion (MES-001/002/006/008/009/010/011).
// ---------------------------------------------------------------------------

enum WorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum WoOperationStatus {
  PENDING
  RUNNING
  DONE
}

/// Work order (MES-001): produces an output SKU against the released
/// BOM/routing snapshot. Material is issued from the stock ledger at
/// release (MES-006); completion receipts good quantity back and
/// records scrap (MES-010/011). Never stores stock truth.
model WorkOrder {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  woNumber      String          @map("wo_number")
  skuId         String          @map("sku_id") @db.Uuid
  warehouseId   String          @map("warehouse_id") @db.Uuid
  bomId         String          @map("bom_id") @db.Uuid
  routingId     String?         @map("routing_id") @db.Uuid
  quantity      Decimal         @db.Decimal(18, 6)
  goodQuantity  Decimal         @default(0) @map("good_quantity") @db.Decimal(18, 6)
  scrapQuantity Decimal         @default(0) @map("scrap_quantity") @db.Decimal(18, 6)
  status        WorkOrderStatus @default(PLANNED)
  startedAt     DateTime?       @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  createdBy     String?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  operations WorkOrderOperation[]

  @@unique([tenantId, woNumber])
  @@index([tenantId, status])
  @@map("work_order")
}

/// Operation snapshot copied from the released routing (MES-002/009).
model WorkOrderOperation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  workOrderId String            @map("work_order_id") @db.Uuid
  seq         Int
  name        String
  workCenter  String            @map("work_center")
  status      WoOperationStatus @default(PENDING)
  startedAt   DateTime?         @map("started_at")
  completedAt DateTime?         @map("completed_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@unique([tenantId, workOrderId, seq])
  @@map("work_order_operation")
}

// ---------------------------------------------------------------------------
// Sprint 012 — Quality: QC plans, inspections, NCRs, production blocking
// (VER-013/014 + quality events).
// ---------------------------------------------------------------------------

enum QcInspectionStatus {
  PENDING
  PASSED
  FAILED
}

enum NcrSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum NcrStatus {
  OPEN
  RESOLVED
}

/// QC plan per SKU (VER-013): the checklist an inspection must cover.
model QcPlan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  items  QcPlanItem[]

  @@unique([tenantId, skuId])
  @@map("qc_plan")
}

model QcPlanItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  planId      String @map("plan_id") @db.Uuid
  seq         Int
  name        String
  requirement String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   QcPlan @relation(fields: [planId], references: [id])

  @@unique([tenantId, planId, seq])
  @@map("qc_plan_item")
}

/// Inspection against a work order (VER-013/014): item results are
/// recorded by an inspector; finalization is a supervisor decision.
model QcInspection {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  inspectionNumber String             @map("inspection_number")
  workOrderId      String             @map("work_order_id") @db.Uuid
  skuId            String             @map("sku_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           QcInspectionStatus @default(PENDING)
  decidedBy        String?            @map("decided_by")
  notes            String?
  createdBy        String?            @map("created_by")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  items  QcInspectionItem[]

  @@unique([tenantId, inspectionNumber])
  @@index([tenantId, workOrderId])
  @@map("qc_inspection")
}

model QcInspectionItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  inspectionId String   @map("inspection_id") @db.Uuid
  seq          Int
  name         String
  requirement  String
  passed       Boolean?
  note         String?

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  inspection QcInspection @relation(fields: [inspectionId], references: [id])

  @@unique([tenantId, inspectionId, seq])
  @@map("qc_inspection_item")
}

/// Nonconformance report: opened automatically on failed inspections,
/// or manually; resolution is audited.
model Ncr {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  ncrNumber   String      @map("ncr_number")
  workOrderId String?     @map("work_order_id") @db.Uuid
  skuId       String      @map("sku_id") @db.Uuid
  description String
  severity    NcrSeverity @default(MAJOR)
  status      NcrStatus   @default(OPEN)
  resolution  String?
  resolvedBy  String?     @map("resolved_by")
  createdBy   String?     @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, ncrNumber])
  @@index([tenantId, status])
  @@map("ncr")
}

// ---------------------------------------------------------------------------
// Sprint 013 — Operational finance: AR/AP invoices, payment matching,
// margin and P&L read models (FIN-003/007/011/012/014/019).
// ---------------------------------------------------------------------------

enum InvoiceType {
  CUSTOMER
  SUPPLIER
}

enum InvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

/// Operational invoice (FIN-011/012): CUSTOMER invoices bill fulfilled
/// sales orders (AR); SUPPLIER invoices record received purchase orders
/// (AP). Money is decimal + explicit currency; paidAmount only moves
/// through matched payments.
model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  invoiceNumber String        @map("invoice_number")
  invoiceType   InvoiceType   @map("invoice_type")
  partyRefId    String        @map("party_ref_id") @db.Uuid
  orderRefId    String        @map("order_ref_id") @db.Uuid
  currency      String        @db.Char(3)
  total         Decimal       @db.Decimal(18, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 2)
  status        InvoiceStatus @default(OPEN)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  dueAt         DateTime?     @map("due_at")
  /// Sprint 019 (FIN-016): actual spend/revenue attribution.
  costCenterId  String?       @map("cost_center_id") @db.Uuid
  createdBy     String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, invoiceType, orderRefId])
  @@index([tenantId, status])
  @@map("invoice")
}

/// Payment matched to an invoice (FIN-014). Append-only.
model Payment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  paymentNumber String   @map("payment_number")
  invoiceId     String   @map("invoice_id") @db.Uuid
  amount        Decimal  @db.Decimal(18, 2)
  currency      String   @db.Char(3)
  reference     String?
  receivedAt    DateTime @default(now()) @map("received_at")
  createdBy     String?  @map("created_by")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, invoiceId])
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Sprint 015 — B2B workspace: portal users bound to CRM accounts
// (B2B-001/002); everything they see is scoped to their account.
// ---------------------------------------------------------------------------

enum PortalUserStatus {
  ACTIVE
  DISABLED
}

model PortalUser {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  accountId   String           @map("account_id") @db.Uuid
  idpSubject  String           @map("idp_subject")
  displayName String           @map("display_name")
  email       String?
  status      PortalUserStatus @default(ACTIVE)
  createdBy   String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idpSubject])
  @@index([tenantId, accountId])
  @@map("portal_user")
}

// ---------------------------------------------------------------------------
// Sprint 016 — Collaboration & findability: comments with mentions
// (CORE-010), attachments behind a storage port (CORE-009) and governed
// number sequences (CORE-008). Global search (CORE-011) is query-only.
// ---------------------------------------------------------------------------

/// Comment on any business record (CORE-010). Append-only; mentions
/// carry the mentioned user ids and fan out as notifications.
model Comment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  body       String
  mentions   String[] @default([])
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId, createdAt])
  @@map("comment")
}

/// Attachment metadata (CORE-009). Bytes live behind the storage port;
/// the default adapter keeps them in attachment_blob so listings never
/// load content.
model Attachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  storageKey  String   @map("storage_key")
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  blob   AttachmentBlob?

  @@index([tenantId, entityType, entityId])
  @@map("attachment")
}

/// Default storage-adapter payload table (database-backed object store).
model AttachmentBlob {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  attachmentId String @unique @map("attachment_id") @db.Uuid
  data         Bytes

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@map("attachment_blob")
}

/// Governed per-tenant number sequence (CORE-008): one row per document
/// family, advanced atomically so numbers never collide or reuse.
model NumberSequence {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  sequenceKey String   @map("sequence_key")
  prefix      String   @default("")
  padding     Int      @default(5)
  nextValue   Int      @default(1) @map("next_value")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sequenceKey])
  @@map("number_sequence")
}

// ---------------------------------------------------------------------------
// Sprint 019 — Financial depth: cost centers (FIN-016), budgets
// (FIN-008) and the invoice cost-center link that ties actual spend to
// them. Aging and cash flow are read models over invoices/payments.
// ---------------------------------------------------------------------------

model CostCenter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  budgets Budget[]

  @@unique([tenantId, code])
  @@map("cost_center")
}

/// Budget per cost center and period (FIN-008). periodKey is
/// 'YYYY' or 'YYYY-MM'; actuals aggregate supplier invoices linked to
/// the cost center inside the period.
model Budget {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  costCenterId String   @map("cost_center_id") @db.Uuid
  periodKey    String   @map("period_key")
  amount       Decimal  @db.Decimal(18, 2)
  currency     String   @db.Char(3)
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  costCenter CostCenter @relation(fields: [costCenterId], references: [id])

  @@unique([tenantId, costCenterId, periodKey])
  @@map("budget")
}

// ---------------------------------------------------------------------------
// Sprint 020 — Integration hub: webhook subscriptions (INT-008) with
// idempotent fan-out (INT-011), retrying signed deliveries (INT-012),
// dead-lettering (INT-013) and run history (INT-016).
// ---------------------------------------------------------------------------

model WebhookSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  url        String
  /// HMAC-SHA256 signing secret; generated server-side, shown once.
  secret     String
  eventTypes String[] @map("event_types")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@unique([tenantId, name])
  @@map("webhook_subscription")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

/// One attempt-tracked delivery of one event to one subscription.
/// (subscription, outbox event) is unique, so fan-out retries are
/// exactly-once (INT-011).
model WebhookDelivery {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  outboxEventId  String                @map("outbox_event_id") @db.Uuid
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at")
  lastError      String?               @map("last_error")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, outboxEventId])
  @@index([tenantId, status, nextAttemptAt])
  @@map("webhook_delivery")
}

// ---------------------------------------------------------------------------
// Sprint 021 — Platform ops & security: service accounts / API keys
// (IAM-009) and the security event log (IAM-013). Usage analytics and
// tenant export are read models.
// ---------------------------------------------------------------------------

/// Service account key (IAM-009). Only a SHA-256 hash is stored; the
/// full key is shown once at creation. Permissions are an explicit
/// allowlist — narrower than any human role.
model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  prefix      String
  keyHash     String    @unique @map("key_hash")
  permissions String[]
  active      Boolean   @default(true)
  lastUsedAt  DateTime? @map("last_used_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("api_key")
}

/// Append-only security event log (IAM-013).
model SecurityEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  eventType String   @map("event_type")
  subject   String?
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("security_event")
}

// ---------------------------------------------------------------------------
// Sprint 025 — PIM depth: category tree (PIM-004); variants and typed
// attributes live on Product/Sku (PIM-002/003).
// ---------------------------------------------------------------------------

model ProductCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")

  @@unique([tenantId, code])
  @@map("product_category")
}

// ---------------------------------------------------------------------------
// Sprint 028 — Returns (OMS-012/COM-011): RMA lifecycle with idempotent
// stock re-entry on receipt.
// ---------------------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  CLOSED
}

model ReturnOrder {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  rmaNumber    String       @map("rma_number")
  orderId      String       @map("order_id") @db.Uuid
  accountId    String       @map("account_id") @db.Uuid
  warehouseId  String       @map("warehouse_id") @db.Uuid
  status       ReturnStatus @default(REQUESTED)
  reason       String
  decisionNote String?      @map("decision_note")
  createdBy    String?      @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  lines  ReturnOrderLine[]

  @@unique([tenantId, rmaNumber])
  @@index([tenantId, status])
  @@map("return_order")
}

model ReturnOrderLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  returnId    String  @map("return_id") @db.Uuid
  orderLineId String  @map("order_line_id") @db.Uuid
  skuId       String  @map("sku_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  returnOrder ReturnOrder @relation(fields: [returnId], references: [id])

  @@index([tenantId, returnId])
  @@map("return_order_line")
}

// ---------------------------------------------------------------------------
// Sprint 030 — Stock counting (WMS-015) with adjustment governance
// (WMS-016): variances post as governed, idempotent ledger adjustments,
// and the person who created a count cannot post it.
// ---------------------------------------------------------------------------

enum StockCountStatus {
  OPEN
  POSTED
  CANCELLED
}

model StockCount {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  countNumber String           @map("count_number")
  warehouseId String           @map("warehouse_id") @db.Uuid
  status      StockCountStatus @default(OPEN)
  note        String?
  createdBy   String?          @map("created_by")
  postedBy    String?          @map("posted_by")
  postedAt    DateTime?        @map("posted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  lines  StockCountLine[]

  @@unique([tenantId, countNumber])
  @@index([tenantId, status])
  @@map("stock_count")
}

model StockCountLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  countId     String  @map("count_id") @db.Uuid
  skuId       String  @map("sku_id") @db.Uuid
  /// On-hand snapshot at the moment the line was added.
  expectedQty Decimal @map("expected_qty") @db.Decimal(18, 6)
  countedQty  Decimal @map("counted_qty") @db.Decimal(18, 6)

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  count  StockCount @relation(fields: [countId], references: [id])

  @@unique([countId, skuId])
  @@index([tenantId, countId])
  @@map("stock_count_line")
}

// ---------------------------------------------------------------------------
// Sprint 031 — MES depth: work-center master data (MES-003), downtime
// logging (MES-014) and OEE inputs (MES-021) as read models.
// ---------------------------------------------------------------------------

model WorkCenter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  downtimes DowntimeEvent[]

  @@unique([tenantId, code])
  @@map("work_center")
}

enum DowntimeCategory {
  BREAKDOWN
  SETUP
  MATERIAL
  QUALITY
  OTHER
}

/// Logged downtime (MES-014). Append-only; minutes are recorded
/// directly so shop-floor entry stays one step.
model DowntimeEvent {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  workCenterId String           @map("work_center_id") @db.Uuid
  workOrderId  String?          @map("work_order_id") @db.Uuid
  category     DowntimeCategory @default(OTHER)
  minutes      Int
  reason       String
  occurredAt   DateTime         @default(now()) @map("occurred_at")
  createdBy    String?          @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id])

  @@index([tenantId, workCenterId, occurredAt])
  @@map("downtime_event")
}
