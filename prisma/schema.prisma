enum PriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// CPQ-001 price lists; entries carry quantity breaks (CPQ-002).
model PriceList {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  code      String
  name      String
  currency  String          @db.Char(3)
  status    PriceListStatus @default(DRAFT)
  validFrom DateTime?       @map("valid_from")
  validTo   DateTime?       @map("valid_to")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  entries PriceListEntry[]

  @@unique([tenantId, code])
  @@map("price_list")
}

model PriceListEntry {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  priceListId String  @map("price_list_id") @db.Uuid
  skuId       String  @map("sku_id") @db.Uuid
  /// Quantity break threshold: the entry applies from this quantity up.
  minQty      Decimal @default(1) @map("min_qty") @db.Decimal(18, 6)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  priceList PriceList @relation(fields: [priceListId], references: [id])

  @@unique([tenantId, priceListId, skuId, minQty])
  @@map("price_list_entry")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// CPQ-011/012 quote lifecycle with versioning; discounts above the margin
/// floor require approval (CPQ-004/005) through the WF approval service.
model Quote {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  quoteNumber   String      @map("quote_number")
  version       Int         @default(1)
  supersedesId  String?     @map("supersedes_id") @db.Uuid
  accountId     String      @map("account_id") @db.Uuid
  opportunityId String?     @map("opportunity_id") @db.Uuid
  priceListId   String      @map("price_list_id") @db.Uuid
  status        QuoteStatus @default(DRAFT)
  currency      String      @db.Char(3)
  subtotal      Decimal     @default(0) @db.Decimal(18, 2)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(18, 2)
  total         Decimal     @default(0) @db.Decimal(18, 2)
  validUntil    DateTime?   @map("valid_until")
  approvalId    String?     @map("approval_id") @db.Uuid
  createdBy     String?     @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  lines  QuoteLine[]

  @@unique([tenantId, quoteNumber, version])
  @@index([tenantId, accountId])
  @@index([tenantId, status])
  @@map("quote")
}

model QuoteLine {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  quoteId       String  @map("quote_id") @db.Uuid
  skuId         String  @map("sku_id") @db.Uuid
  description   String
  quantity      Decimal @db.Decimal(18, 6)
  listUnitPrice Decimal @map("list_unit_price") @db.Decimal(18, 4)
  discountPct   Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  netUnitPrice  Decimal @map("net_unit_price") @db.Decimal(18, 4)
  lineTotal     Decimal @map("line_total") @db.Decimal(18, 2)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  quote  Quote  @relation(fields: [quoteId], references: [id])

  @@index([tenantId, quoteId])
  @@map("quote_line")
}

// --- Sprint 007: OMS — canonical sales orders, holds, reservation orchestration ---

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  ON_HOLD
  FULFILLED
  CANCELLED
}

/// Canonical customer order (OMS-001). Confirmation reserves stock through
/// the WMS public interface (OMS-004); cancellation compensates by
/// releasing reservations (OMS-010); fulfillment consumes them via ledger
/// ISSUE movements (OMS-011). Never stores stock truth.
model SalesOrder {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  orderNumber String           @map("order_number")
  accountId   String           @map("account_id") @db.Uuid
  quoteId     String?          @map("quote_id") @db.Uuid
  warehouseId String           @map("warehouse_id") @db.Uuid
  status      SalesOrderStatus @default(DRAFT)
  currency    String           @db.Char(3)
  total       Decimal          @default(0) @db.Decimal(18, 2)
  holdReason  String?          @map("hold_reason")
  createdBy   String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  lines  SalesOrderLine[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, accountId])
  @@map("sales_order")
}

model SalesOrderLine {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  skuId         String  @map("sku_id") @db.Uuid
  description   String
  quantity      Decimal @db.Decimal(18, 6)
  unitPrice     Decimal @map("unit_price") @db.Decimal(18, 4)
  lineTotal     Decimal @map("line_total") @db.Decimal(18, 2)
  reservationId String? @map("reservation_id") @db.Uuid
  /// Sprint 018 (OMS-006): confirmed without stock; released later.
  backordered   Boolean @default(false)

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  order  SalesOrder @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@map("sales_order_line")
}

/// Order status timeline (OMS-013): append-only history of what happened.
model OrderEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  eventType String   @map("event_type")
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, orderId, createdAt])
  @@map("order_event")
}

// ---------------------------------------------------------------------------
// Sprint 008 — Procurement & inbound (PROC-001/002/003/005/009/013).
