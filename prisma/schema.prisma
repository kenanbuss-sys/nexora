// NEXORA — Enterprise Business OS
// Sprint 001: CORE (tenant, organization, configuration, audit) + IAM
// (users, roles, scoped permissions) + transactional outbox.
//
// Conventions (docs/architecture/02_CANONICAL_DATA_MODEL.md):
// - every transactional aggregate: immutable ID, tenant ownership, timestamps,
//   explicit lifecycle state, optimistic version where contention matters
// - no customer-specific columns
//
// The client is generated engine-free (queryCompiler + driverAdapters) into
// packages/db/generated and committed; CI verifies it matches this schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  engineType      = "client"
  output          = "../packages/db/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CORE — tenant & configuration
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  configurationVersions TenantConfigurationVersion[]
  legalEntities         LegalEntity[]
  businessUnits         BusinessUnit[]
  branches              Branch[]
  factories             Factory[]
  users                 User[]
  roles                 Role[]
  roleAssignments       UserRoleAssignment[]
  auditEvents           AuditEvent[]
  outboxEvents          OutboxEvent[]
  terminologyEntries    TerminologyEntry[]
  moduleActivations     ModuleActivation[]
  customFieldDefs       CustomFieldDefinition[]
  tasks                 Task[]
  notifications         Notification[]
  workflowDefinitions   WorkflowDefinition[]
  ruleDefinitions       RuleDefinition[]
  approvals             Approval[]
  processedEvents       ProcessedEvent[]
  documentTemplates     DocumentTemplate[]
  parties               Party[]
  products              Product[]
  warehouses            Warehouse[]
  stockMovements        StockMovement[]
  stockReservations     StockReservation[]
  devices               Device[]
  scanEvents            ScanEvent[]
  wmsOrders             WmsOrder[]
  wmsOrderLines         WmsOrderLine[]
  crmAccounts           CrmAccount[]
  leads                 Lead[]
  opportunities         Opportunity[]
  crmActivities         CrmActivity[]
  priceLists            PriceList[]
  priceListEntries      PriceListEntry[]
  quotes                Quote[]
  quoteLines            QuoteLine[]
  salesOrders           SalesOrder[]
  salesOrderLines       SalesOrderLine[]
  orderEvents           OrderEvent[]
  suppliers             Supplier[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseReqLines      PurchaseRequisitionLine[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderLines    PurchaseOrderLine[]
  boms                  Bom[]
  bomLines              BomLine[]
  routings              Routing[]
  routingOperations     RoutingOperation[]
  engineeringChanges    EngineeringChange[]
  planningPolicies      PlanningPolicy[]
  mrpRuns               MrpRun[]
  mrpSuggestions        MrpSuggestion[]
  workOrders            WorkOrder[]
  workOrderOperations   WorkOrderOperation[]

  @@map("tenant")
}

model TenantConfigurationVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  version     Int
  config      Json
  publishedAt DateTime @default(now()) @map("published_at")
  publishedBy String?  @map("published_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, version])
  @@map("tenant_configuration_version")
}

// ---------------------------------------------------------------------------
// CORE — organization tree (LegalEntity -> BusinessUnit -> Branch/Factory)
// ---------------------------------------------------------------------------

model LegalEntity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  businessUnits BusinessUnit[]

  @@unique([tenantId, name])
  @@map("legal_entity")
}

model BusinessUnit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  legalEntityId String   @map("legal_entity_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  name          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  legalEntity LegalEntity    @relation(fields: [legalEntityId], references: [id])
  parent      BusinessUnit?  @relation("BusinessUnitTree", fields: [parentId], references: [id])
  children    BusinessUnit[] @relation("BusinessUnitTree")
  branches    Branch[]
  factories   Factory[]

  @@unique([tenantId, legalEntityId, name])
  @@map("business_unit")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  businessUnitId String   @map("business_unit_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])

  @@unique([tenantId, businessUnitId, name])
  @@map("branch")
}

model Factory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  businessUnitId String   @map("business_unit_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])

  @@unique([tenantId, businessUnitId, name])
  @@map("factory")
}

// ---------------------------------------------------------------------------
// IAM — users, roles, scoped permissions
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  email       String
  displayName String     @map("display_name")
  status      UserStatus @default(INVITED)
  /// Subject identifier at the OIDC identity provider (provider-neutral linkage).
  idpSubject  String?    @map("idp_subject")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  roleAssignments UserRoleAssignment[]

  @@unique([tenantId, email])
  @@index([tenantId, idpSubject])
  @@map("user")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([tenantId, name])
  @@map("role")
}

model RolePermission {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  /// Permission key, `<domain>.<resource/action>` (specs/permissions.csv).
  permissionKey String @map("permission_key")

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permission")
}

enum ScopeType {
  TENANT
  LEGAL_ENTITY
  BUSINESS_UNIT
  BRANCH
  FACTORY
}

model UserRoleAssignment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  scopeType ScopeType @default(TENANT) @map("scope_type")
  /// Scope target: the tenant id for TENANT scope, otherwise the org node id.
  scopeId   String    @map("scope_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId, scopeType, scopeId])
  @@index([tenantId, userId])
  @@map("user_role_assignment")
}

// ---------------------------------------------------------------------------
// CORE — immutable audit (docs/security/03_AUDIT_SPEC.md)
// ---------------------------------------------------------------------------

enum ActorType {
  USER
  SERVICE
  SYSTEM
}

model AuditEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id")
  action         String
  objectType     String    @map("object_type")
  objectId       String    @map("object_id")
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  correlationId  String    @map("correlation_id")
  /// Source channel: api | worker | integration | device | system
  source         String
  previousValues Json?     @map("previous_values")
  newValues      Json?     @map("new_values")
  reason         String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, objectType, objectId])
  @@index([tenantId, occurredAt])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Transactional outbox (docs/architecture/03_EVENT_ARCHITECTURE.md)
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  eventType     String       @map("event_type")
  eventVersion  Int          @default(1) @map("event_version")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  actorType     ActorType    @map("actor_type")
  actorId       String?      @map("actor_id")
  correlationId String       @map("correlation_id")
  causationId   String?      @map("causation_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  dispatchedAt  DateTime?    @map("dispatched_at")
  lastError     String?      @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status, occurredAt])
  @@map("outbox_event")
}

// ---------------------------------------------------------------------------
// Sprint 002 — CORE: terminology, module activation, custom fields,
// tasks & notifications
// ---------------------------------------------------------------------------

model TerminologyEntry {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  locale   String @default("en")
  key      String
  label    String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, locale, key])
  @@map("terminology_entry")
}

model ModuleActivation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleKey String   @map("module_key")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleKey])
  @@map("module_activation")
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  JSON
}

model CustomFieldDefinition {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  objectType String          @map("object_type")
  key        String
  label      String
  fieldType  CustomFieldType @map("field_type")
  required   Boolean         @default(false)
  config     Json?
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, objectType, key])
  @@map("custom_field_definition")
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Task {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  title             String
  description       String?
  status            TaskStatus @default(OPEN)
  assigneeUserId    String?    @map("assignee_user_id") @db.Uuid
  dueAt             DateTime?  @map("due_at")
  relatedObjectType String?    @map("related_object_type")
  relatedObjectId   String?    @map("related_object_id")
  createdByUserId   String?    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, assigneeUserId, status])
  @@map("task")
}

model Notification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String
  title             String
  body              String?
  readAt            DateTime? @map("read_at")
  relatedObjectType String?   @map("related_object_type")
  relatedObjectId   String?   @map("related_object_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId, readAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Sprint 002 — WF: versioned workflows, rules, approvals
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  name     String

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  versions  WorkflowVersion[]
  instances WorkflowInstance[]

  @@unique([tenantId, key])
  @@map("workflow_definition")
}

model WorkflowVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  version      Int
  /// Immutable published graph: { initial, states[], transitions[] }
  spec         Json
  publishedAt  DateTime @default(now()) @map("published_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id])
  instances  WorkflowInstance[]

  @@unique([definitionId, version])
  @@map("workflow_version")
}

enum WorkflowInstanceStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

model WorkflowInstance {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  definitionId      String                 @map("definition_id") @db.Uuid
  versionId         String                 @map("version_id") @db.Uuid
  currentState      String                 @map("current_state")
  status            WorkflowInstanceStatus @default(RUNNING)
  subjectObjectType String?                @map("subject_object_type")
  subjectObjectId   String?                @map("subject_object_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id])
  version    WorkflowVersion    @relation(fields: [versionId], references: [id])

  @@index([tenantId, status])
  @@map("workflow_instance")
}

model RuleDefinition {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  name     String

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  versions RuleVersion[]

  @@unique([tenantId, key])
  @@map("rule_definition")
}

model RuleVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ruleId      String   @map("rule_id") @db.Uuid
  version     Int
  /// Immutable published rule: { when, if[], then[] }
  spec        Json
  enabled     Boolean  @default(true)
  publishedAt DateTime @default(now()) @map("published_at")

  rule RuleDefinition @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, version])
  @@index([tenantId, enabled])
  @@map("rule_version")
}

enum ApprovalStatus {
  REQUESTED
  GRANTED
  REJECTED
}

model Approval {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  subjectObjectType  String         @map("subject_object_type")
  subjectObjectId    String         @map("subject_object_id")
  title              String
  status             ApprovalStatus @default(REQUESTED)
  requestedByUserId  String?        @map("requested_by_user_id") @db.Uuid
  decidedByUserId    String?        @map("decided_by_user_id") @db.Uuid
  reason             String?
  workflowInstanceId String?        @map("workflow_instance_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  decidedAt          DateTime?      @map("decided_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("approval")
}

/// Consumer-side dedupe for event-driven automation (idempotent consumers).
model ProcessedEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([eventId, consumer])
  @@map("processed_event")
}

// ---------------------------------------------------------------------------
// Sprint 002 — DOC: document template foundation
// ---------------------------------------------------------------------------

model DocumentTemplate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  name     String

  tenant   Tenant                    @relation(fields: [tenantId], references: [id])
  versions DocumentTemplateVersion[]

  @@unique([tenantId, key])
  @@map("document_template")
}

model DocumentTemplateVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  version     Int
  /// Immutable template body (rendering arrives in a later sprint).
  content     String
  publishedAt DateTime @default(now()) @map("published_at")

  template DocumentTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, version])
  @@map("document_template_version")
}

// ---------------------------------------------------------------------------
// Sprint 003 — MDM: canonical parties, merge, external identity mapping
// ---------------------------------------------------------------------------

enum PartyType {
  PERSON
  ORGANIZATION
}

enum PartyStatus {
  ACTIVE
  MERGED
}

model Party {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  partyType      PartyType   @map("party_type")
  name           String
  /// Lowercased/trimmed name for duplicate detection.
  normalizedName String      @map("normalized_name")
  email          String?
  taxId          String?     @map("tax_id")
  status         PartyStatus @default(ACTIVE)
  /// Set when status=MERGED: the surviving canonical party (redirect preserved).
  mergedIntoId   String?     @map("merged_into_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  mergedInto         Party?                  @relation("PartyMergeRedirect", fields: [mergedIntoId], references: [id])
  mergedParties      Party[]                 @relation("PartyMergeRedirect")
  externalIdentities PartyExternalIdentity[]

  @@index([tenantId, normalizedName])
  @@map("party")
}

model PartyExternalIdentity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  partyId      String   @map("party_id") @db.Uuid
  sourceSystem String   @map("source_system")
  externalId   String   @map("external_id")
  createdAt    DateTime @default(now()) @map("created_at")

  party Party @relation(fields: [partyId], references: [id])

  @@unique([tenantId, sourceSystem, externalId])
  @@map("party_external_identity")
}

// ---------------------------------------------------------------------------
// Sprint 003 — PIM: products, SKUs, barcodes, UOM conversions
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SkuStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

model Product {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  skus   Sku[]

  @@unique([tenantId, code])
  @@map("product")
}

model Sku {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  code      String
  name      String
  /// Base unit of measure; cannot casually change once transactions exist.
  baseUom   String    @map("base_uom")
  status    SkuStatus @default(DRAFT)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id])
  barcodes       Barcode[]
  uomConversions UomConversion[]

  @@unique([tenantId, code])
  @@map("sku")
}

model Barcode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  skuId       String   @map("sku_id") @db.Uuid
  value       String
  barcodeType String   @default("GTIN") @map("barcode_type")
  createdAt   DateTime @default(now()) @map("created_at")

  sku Sku @relation(fields: [skuId], references: [id])

  @@unique([tenantId, value])
  @@map("barcode")
}

model UomConversion {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  skuId   String  @map("sku_id") @db.Uuid
  fromUom String  @map("from_uom")
  toUom   String  @map("to_uom")
  factor  Decimal @db.Decimal(18, 6)

  sku Sku @relation(fields: [skuId], references: [id])

  @@unique([skuId, fromUom, toUom])
  @@map("uom_conversion")
}

// ---------------------------------------------------------------------------
// Sprint 004 — WMS: warehouse topology, immutable stock ledger, reservations
// ---------------------------------------------------------------------------

model Warehouse {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  locations WarehouseLocation[]

  @@unique([tenantId, code])
  @@map("warehouse")
}

model WarehouseLocation {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  code        String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
  @@map("warehouse_location")
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

/// Immutable inventory ledger: stock truth is the sum of movements.
/// Corrections are new (reversal) movements; rows are never edited.
model StockMovement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  locationId     String?           @map("location_id") @db.Uuid
  skuId          String            @map("sku_id") @db.Uuid
  movementType   StockMovementType @map("movement_type")
  /// Always positive; the sign comes from movementType.
  quantity       Decimal           @db.Decimal(18, 6)
  reason         String?
  /// Business idempotency key: duplicate submissions produce one stock effect.
  idempotencyKey String            @map("idempotency_key")
  occurredAt     DateTime          @default(now()) @map("occurred_at")
  createdBy      String?           @map("created_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, warehouseId, skuId])
  @@map("stock_movement")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model StockReservation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  skuId       String            @map("sku_id") @db.Uuid
  quantity    Decimal           @db.Decimal(18, 6)
  status      ReservationStatus @default(ACTIVE)
  /// Demand reference, e.g. a sales order id (OMS orchestrates through WMS).
  reference   String?
  createdAt   DateTime          @default(now()) @map("created_at")
  releasedAt  DateTime?         @map("released_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, warehouseId, skuId, status])
  @@map("stock_reservation")
}

// --- Sprint 005: DEV device registry + VER verification events + WMS execution ---

enum DeviceType {
  SCANNER
  TABLET
  PRINTER
  SCALE
  OTHER
}

enum DeviceStatus {
  ENROLLED
  ACTIVE
  SUSPENDED
}

/// Device registry (DEV-001..004). Hardware specifics live behind adapters;
/// business logic never binds to a hardware model (Sprint 005 rule).
model Device {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  code            String
  name            String
  deviceType      DeviceType   @map("device_type")
  status          DeviceStatus @default(ENROLLED)
  /// One-time secret used by the physical device to claim its identity.
  enrollmentToken String       @unique @map("enrollment_token")
  /// Detected capabilities (VER-019), e.g. {"barcode":true,"camera":false}.
  capabilities    Json?
  assignedUserId  String?      @map("assigned_user_id") @db.Uuid
  branchId        String?      @map("branch_id") @db.Uuid
  lastSeenAt      DateTime?    @map("last_seen_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("device")
}

enum ScanKind {
  BARCODE
  QR
  RFID
  NFC
}

/// Verification event stream (VER-001/002, offline queue VER-017, idempotent
/// replay VER-018, correlation VER-020). Client-generated ids make replays
/// after offline periods exactly-once.
model ScanEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  deviceId      String   @map("device_id") @db.Uuid
  kind          ScanKind
  value         String
  context       Json?
  clientEventId String   @map("client_event_id")
  capturedAt    DateTime @map("captured_at")
  receivedAt    DateTime @default(now()) @map("received_at")
  correlationId String?  @map("correlation_id")
  resolvedSkuId String?  @map("resolved_sku_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, deviceId, clientEventId])
  @@index([tenantId, receivedAt])
  @@map("scan_event")
}

enum WmsOrderType {
  RECEIVING
  TRANSFER
  COUNT
  PICK
}

enum WmsOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Warehouse execution document (WMS-004 receiving, WMS-013 transfers,
/// WMS-014 counts, WMS-010/011 pick/pack). Executing lines posts movements
/// through the inventory ledger — the document never stores stock truth.
model WmsOrder {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  orderType     WmsOrderType   @map("order_type")
  status        WmsOrderStatus @default(DRAFT)
  warehouseId   String         @map("warehouse_id") @db.Uuid
  /// Destination warehouse for transfers.
  toWarehouseId String?        @map("to_warehouse_id") @db.Uuid
  reference     String?
  createdBy     String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  completedAt   DateTime?      @map("completed_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  lines  WmsOrderLine[]

  @@index([tenantId, warehouseId, status])
  @@map("wms_order")
}

model WmsOrderLine {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  skuId        String  @map("sku_id") @db.Uuid
  expectedQty  Decimal @map("expected_qty") @db.Decimal(18, 6)
  processedQty Decimal @default(0) @map("processed_qty") @db.Decimal(18, 6)

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  order  WmsOrder @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@map("wms_order_line")
}

// --- Sprint 006: CRM (accounts, leads, opportunities, activities) + CPQ (price lists, quotes) ---

