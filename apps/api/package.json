{
  "name": "@nexora/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@nexora/config": "workspace:*",
    "@nexora/observability": "workspace:*",
    "fastify": "^5.12.0",
    "ioredis": "^5.9.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
