{
  "name": "nexora",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "validate:specs": "python3 scripts/validate_spec_pack.py"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@prisma/engines",
      "msgpackr-extract",
      "prisma",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.0",
    "prisma": "^6.19.0",
    "turbo": "^2.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0"
  }
}
